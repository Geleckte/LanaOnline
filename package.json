{
  "name": "lanaonline",
  "version": "1.0.0",
  "private": true,
  "description": "Status + Nachrichten für dich und Lana",
  "author": "Geleckte",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "build:desktop": "vite build && electron-builder --win",
    "preview": "vite preview",
    "start": "electron .",
    "deploy:web": "vite build && npx --yes gh-pages -d dist -m \"deploy website\""
  },
  "build": {
    "appId": "com.lanaonline.app",
    "productName": "LanaOnline",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "electron/icon.png",
      "artifactName": "LanaOnline-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LanaOnline",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "mqtt": "^5.13.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "wait-on": "^8.0.3"
  }
}
